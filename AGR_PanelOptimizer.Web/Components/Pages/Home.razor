@page "/"

@using AGR_PanelOptimizer.Core.Models
@using AGR_PanelOptimizer.Core.Interfaces
@using AGR_PanelOptimizer.Web.Components.Order
@using AGR_PanelOptimizer.Web.Components.Results

@inject IPanelOptimizer Optimizer

<PageTitle>Panel Optimizer</PageTitle>

<div class="page-container">

    <header class="page-header">
        <h1>Panel Optimizer</h1>
        <p>Расчет и визуализация раскроя сэндвич-панелей</p>
    </header>

    <PanelSettingsForm Settings="Settings" />

    <ValveOrderGrid Orders="Orders" />

    <div class="actions">
        <button type="button"
                class="button button-primary"
                @onclick="Calculate">
            Рассчитать
        </button>
    </div>

    @if (Result is not null)
    {
        <OptimizationSummary Result="Result" />
        <CuttingPlanView Plan="Result.CuttingPlan" />
        <ValveResultsView Results="Result.Valves" />
    }

</div>

@code {

    private PanelSettings Settings { get; } = new();

    private List<ValveOrder> Orders { get; } =
    [
        new ValveOrder()
    ];

    private OptimizationResult? Result;

    private void Calculate()
    {
        Result = Optimizer.Calculate(
            Settings,
            Orders);
    }
}